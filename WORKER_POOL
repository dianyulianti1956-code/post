// 2. Fungsi Logika Failover untuk Worker Utama
async function fetchWithFailover(endpointPath, options = {}) {
    let attempts = 0;
    let shuffledPool = [...WORKER_POOL].sort(() => Math.random() - 0.5);

    while (attempts < shuffledPool.length) {
        let currentWorker = shuffledPool[attempts];
        let currentUrl = `${currentWorker}${endpointPath}`;

        try {
            let response = await fetch(currentUrl, options);
            if (response.status === 429 || response.status >= 500) {
                throw new Error(`Worker status error: ${response.status}`);
            }
            return response;
        } catch (err) {
            attempts++;
            if (attempts >= shuffledPool.length) {
                throw new Error("Semua CDN Worker sedang mengalami gangguan atau mencapai limit.");
            }
        }
    }
}

// 3. Worker Pool untuk Gambar (Image Proxy)
const IMAGE_WORKER_POOL = [
    "https://cdn.asetiawanagus232.workers.dev",
    "https://cdn.adidssd7.workers.dev"
];

function getProxiedImage(url, useProxy = true) {
    if (!url) return '';
    if (!useProxy) return url;
    let cleanUrl = url.replace(/^https?:\/\//i, '');
    let randomWorker = IMAGE_WORKER_POOL[Math.floor(Math.random() * IMAGE_WORKER_POOL.length)];
    return `${randomWorker}/?id=` + encodeURIComponent(cleanUrl);
}

